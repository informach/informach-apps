# Local only. Generate independent random secrets; never commit actual values.
NEXT_PUBLIC_APP_URL=http://localhost:3011
DATABASE_URL=postgres://localhost/informach_local
BETTER_AUTH_SECRET=
COMPASSO_TRIAL_HASH_SECRET=
EMAIL_SANDBOX_MODE=memory
EMAIL_SANDBOX_DIR=./tmp/emails
SENDGRID_API_KEY=
SENDGRID_FROM=Minha conta <nao-responda@informach.com.br>
# Enable only after provisioning and verifying the Compasso catalog in Stripe test mode.
COMPASSO_BILLING_ENABLED=false
STRIPE_MODE=dev
COMPASSO_MONTHLY_PRICE=
COMPASSO_ANNUAL_PRICE=
COMPASSO_CREDITS_100_PRICE=
COMPASSO_CREDITS_300_PRICE=
COMPASSO_CREDITS_1000_PRICE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
CRON_SECRET=

# Existing app prices for historical reconciliation. Production uses references
# to the original service variables, generated from the shared product catalog.
MISSAO_INDIVIDUAL_MONTHLY_PRICE=
MISSAO_INDIVIDUAL_ANNUAL_PRICE=
