# Subset que o app agenda-da-turma consome.
DATABASE_URL=postgres://informach:informach@localhost:5432/informach
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Redis (opcional). Quando definido, Better Auth usa secondaryStorage em vez do Postgres
# para sessions/verifications/rate-limits. Em prod (Railway): ${{Redis.REDIS_URL}}?family=0.
REDIS_URL=redis://localhost:6379

# Auth (package @informach/auth, Better Auth)
# Gere o secret com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Email (package @informach/emails, SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM=no-reply@informach.com.br
# Public key do Signed Event Webhook (configurar no painel do SendGrid)
SENDGRID_WEBHOOK_PUBLIC_KEY=
# live | sandbox (sandbox grava arquivos em EMAIL_SANDBOX_DIR ao invés de chamar SendGrid)
EMAIL_SANDBOX_MODE=live
EMAIL_SANDBOX_DIR=./tmp/integration_emails

# Cron jobs (Railway Scheduler)
# Gere o secret com: openssl rand -base64 32
CRON_SECRET=

# Billing (package @informach/billing, Stripe)
# Test keys: sk_test_..., whsec_... (do `stripe listen --forward-to .../api/webhooks/stripe`)
# Live keys: sk_live_..., whsec_live_... (Dashboard → Developers → Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opcional, só se usar Stripe Elements no client side
# STRIPE_PUBLISHABLE_KEY=
# Opcional. Default: "prod" se NODE_ENV=production, senão "dev". Override para testar
# Price IDs de prod em staging.
# STRIPE_MODE=dev

# Google OAuth (opcional). Quando ambos estiverem definidos, o provider Google é ativado.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Observabilidade (opcional em dev)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# AI providers (package @informach/ai-core, Mastra base). Pelo menos um
# precisa estar definido se este app rodar agentes.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Default "info". Apps em dev tipicamente usam "debug".
# MASTRA_LOG_LEVEL=info
