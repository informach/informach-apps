# Bastidores (apps/admin). Variáveis lidas por src/lib/env.ts.
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3003

# Banco compartilhado. As telas abrem uma conexão em que toda transação é só de
# leitura; READONLY_DATABASE_URL aponta para um usuário de banco sem escrita,
# quando existir. As ações (banir, encerrar sessões, auditoria) usam DATABASE_URL.
DATABASE_URL=postgres://informach:informach@localhost:5432/informach
READONLY_DATABASE_URL=

# Redis dos apps. Cozya, Agenda, Missão e Bora Treinar guardam as sessões ali; sem
# ele, encerrar sessões só alcança o Postgres. Obrigatório em produção, com ?family=0 no Railway.
REDIS_URL=redis://localhost:6379

# Autenticação. Gere com: openssl rand -base64 32. Nunca reutilize o segredo de outro app.
BETTER_AUTH_SECRET=

# E-mail (códigos de senha, avisos e resumo da semana).
# live | sandbox (grava em EMAIL_SANDBOX_DIR) | memory (testes)
EMAIL_SANDBOX_MODE=sandbox
EMAIL_SANDBOX_DIR=./tmp/emails
SENDGRID_API_KEY=
SENDGRID_FROM=Bastidores Informach <nao-responda@informach.com.br>
# Além das contas owner, quem mais recebe avisos e o resumo (separado por vírgula).
ADMIN_ALERT_EMAILS=

# Rotinas agendadas (Authorization: Bearer). Gere com: openssl rand -base64 32
CRON_SECRET=

# Endereços conferidos pelo painel. Em produção ficam os domínios públicos; em
# desenvolvimento, por exemplo: {"cozya":"http://localhost:3002","agenda-da-turma":"http://localhost:3001"}
ADMIN_SERVICE_URLS=

# Links para o Stripe no modo certo: dev (test) ou prod (live).
STRIPE_MODE=dev

# Observabilidade. SENTRY_ORG_SLUG monta os links; SENTRY_READ_TOKEN (escopo
# event:read) permite contar erros abertos de cada app no painel.
SENTRY_DSN=
SENTRY_ORG_SLUG=
SENTRY_READ_TOKEN=
LOG_LEVEL=info
