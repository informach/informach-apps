# Servidor do Morada ligado ao Recreio de verdade, na máquina de desenvolvimento.
# Copie para `.env` (ignorado pelo git) e rode `pnpm dev:morada-server`, com o
# portal do Recreio no ar (`pnpm dev:recreio`, porta 3009).
#
# Para desenvolver só o jogo, sem portal nem banco, não é preciso arquivo
# nenhum: `MORADA_PLATAFORMA=falsa pnpm dev:morada-server`.

# `recreio` fala com o Recreio pela API das instâncias. `falsa` é a plataforma
# em memória, só para desenvolvimento.
MORADA_PLATAFORMA=recreio

# Porta HTTP e WebSocket deste servidor.
PORT=3010

# Origem do Recreio que este servidor alcança: API das instâncias
# (`/api/interno/v1`) e chaves públicas (`/api/sdk/v1/jwks`).
RECREIO_API_URL=http://localhost:3009

# O segredo do jogo na API das instâncias: o mesmo valor de
# `RECREIO_HOST_SECRETS.morada` no ambiente do Recreio. Nunca vai para o log.
RECREIO_HOST_SECRET=replace-with-the-same-secret-of-RECREIO_HOST_SECRETS.morada

# Quem assina as sessões de jogo: a origem pública do portal
# (`NEXT_PUBLIC_APP_URL` do Recreio). Só é preciso dizer quando ela é diferente
# de `RECREIO_API_URL` (por exemplo, quando este servidor fala com o Recreio
# por um endereço interno).
# RECREIO_EMISSOR=http://localhost:3009

# Endereço público do WebSocket, igual a `RECREIO_GAME_ORIGINS.morada.ws` no
# Recreio: só a origem, sem caminho. É o que a instância registra e o que o
# navegador recebe para conectar.
MORADA_PUBLIC_URL=ws://localhost:3010

# Origens de página que podem abrir o WebSocket, separadas por vírgula: a
# origem pública do portal, como o navegador a manda.
MORADA_ORIGENS=http://localhost:3009

# `prova` encurta a gravidez e as primeiras fases: é o preset da etapa 1.
MORADA_REGRAS=prova

# Pasta com os pacotes de arte que o empacotador gravou (`pnpm --filter
# @informach/morada-arte empacotar --arte <ARTES_3D_DIR> --saida <pasta>`),
# sempre fora deste repositório. Com ela, `/arte/<arquivo>` entrega os pacotes a
# quem tem sessão de jogo; no Recreio, `RECREIO_GAME_ORIGINS.morada.assets`
# aponta para a origem HTTP deste servidor (`http://localhost:3010`). Sem ela, o
# jogo desenha os moradores procedurais.
# MORADA_ARTE_DIR=

# Quantos mundos a instância aceita ao mesmo tempo.
# MORADA_CAPACIDADE=200

# Segredo para ler `/api/metricas` (24 caracteres ou mais). Sem ele a rota não existe.
# MORADA_METRICAS_TOKEN=

# `debug` mostra também os batimentos e as fotografias de cada mundo.
# LOG_LEVEL=info
