{
  "name": "@informach/ediaula",
  "version": "0.1.0",
  "description": "Editor de vídeo para aulas — o melhor do Camtasia e do Premiere.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Crie com Helena e Julio",
  "scripts": {
    "dev": "node scripts/build-native-helper.mjs && electron-vite dev",
    "build": "node scripts/build-native-helper.mjs && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -b tsconfig.node.json tsconfig.web.json --force",
    "test": "node scripts/build-native-helper.mjs && node --test \"tests/**/*.test.ts\"",
    "shortcut": "node scripts/build-native-helper.mjs && electron-vite build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-shortcuts.ps1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@informach/edi-desktop": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "lucide-react": "^1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@derhuerst/ffprobe-static": "5.3.0",
    "ffmpeg-static": "5.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.8.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
