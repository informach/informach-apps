{
  "name": "@informach/edipdf",
  "version": "0.1.0",
  "description": "Editor de PDF: organizar, editar e salvar — o essencial do Acrobat.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Crie com Helena e Julio",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
