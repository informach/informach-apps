    "fflate": "0.8.3",
    "koffi": "3.3.3",
    "lucide-react": "^1.58.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
