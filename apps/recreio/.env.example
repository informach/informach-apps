DATABASE_URL=postgres://postgres:postgres@localhost:5432/informach
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3009
NEXT_PUBLIC_APP_URL=http://localhost:3009
SENDGRID_API_KEY=SG.local
SENDGRID_FROM=Recreio <nao-responda@informach.com.br>
EMAIL_SANDBOX_MODE=sandbox
EMAIL_SANDBOX_DIR=./tmp/emails
# fechado: acesso por convite da equipe (padrão). aberto: sem o aviso de convite.
RECREIO_ACCESS_MODE=fechado
# Segredo de cada jogo na API das instâncias (id do jogo para segredo de 32+ caracteres).
# O servidor do jogo usa o mesmo valor. Sem o segredo de um jogo, nenhuma instância dele se registra.
RECREIO_HOST_SECRETS={"morada":"replace-with-a-random-secret-of-at-least-32-characters"}
# Origens de cada jogo: `ws` é o endereço público das instâncias (wss: em produção).
RECREIO_GAME_ORIGINS={"morada":{"ws":"ws://localhost:3010"}}
# Jogo de teste (um contador por mundo, para ver a plataforma funcionando sem jogo nenhum).
# Só em desenvolvimento: a validação do ambiente recusa esta variável em produção.
# Para usar, ligue aqui, acrescente "teste" aos dois mapas acima
# ("teste":"<segredo de 32+ caracteres>" e "teste":{"ws":"ws://localhost:3019"})
# e rode: pnpm --filter @informach/recreio-app jogo-de-teste
# RECREIO_JOGO_DE_TESTE=1
# Chave dos tokens (ingresso e sessão de jogo). Sem ela, fora de produção, o app gera um par
# descartável ao subir. Para gerar: pnpm --filter @informach/recreio-app gerar-chave
# RECREIO_TOKEN_KEY_ID=
# RECREIO_TOKEN_PRIVATE_KEY=
# RECREIO_TOKEN_PREVIOUS_PUBLIC_KEYS={}
# Segredo do agendador para /api/jobs/* (32+ caracteres). Sem ele a rotina não roda.
# CRON_SECRET=
# Optional locally; required in production. Keep secrets outside version control.
# REDIS_URL=redis://localhost:6379
# SENTRY_DSN=https://public-key@ingest.sentry.io/project
# NEXT_PUBLIC_SENTRY_DSN=https://public-key@ingest.sentry.io/project
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=informach-nucleo-de-aprendizag
# SENTRY_PROJECT=recreio
