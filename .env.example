# =====================================================================
# informach-platform — exemplo de variáveis de ambiente
# Cada app declara em apps/<app>/.env.example o subset que ele consome.
# Apps NUNCA leem variáveis que pertencem a outro app.
# =====================================================================

# ---- Plataforma ------------------------------------------------------
NODE_ENV=development

# Postgres compartilhado por todos os apps. Em prod, referenciado a partir
# do service Postgres do Railway via ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://informach:informach@localhost:5432/informach

# Redis opcional para Better Auth secondary storage (sessions/verifications/rate-limits).
# Em dev: docker-compose sobe um Redis em :6379.
# Em prod (Railway): ${{Redis.REDIS_PRIVATE_URL}}?family=0 (?family=0 é obrigatório, IPv6).
# Quando vazio, Better Auth cai no fallback database (tabela core.rate_limit etc).
REDIS_URL=redis://localhost:6379

# ---- URLs públicas dos apps -----------------------------------------
NEXT_PUBLIC_AGENDA_URL=http://localhost:3001
NEXT_PUBLIC_COZYA_URL=http://localhost:3002

# ---- Observabilidade (placeholder) ----------------------------------
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# ---- Email (package @informach/emails, SendGrid) --------------------
# Cada app declara seu próprio SENDGRID_API_KEY/SENDGRID_FROM.
# SENDGRID_API_KEY=
# SENDGRID_FROM=no-reply@informach.com.br
# Signed Event Webhook (configurar no painel SendGrid → Mail Settings → Event Webhook)
# SENDGRID_WEBHOOK_PUBLIC_KEY=
# Sandbox: grava emails em arquivos ao invés de enviar via SendGrid (test/integration)
# EMAIL_SANDBOX_MODE=live
# EMAIL_SANDBOX_DIR=./tmp/integration_emails

# ---- Billing (placeholder, package @informach/billing) --------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ---- Auth (package @informach/auth, Better Auth) --------------------
# Gere o secret com: openssl rand -base64 32
# BETTER_AUTH_URL é por app — em dev, igual à URL pública do app
# (http://localhost:3001 para agenda-da-turma, :3002 para cozya).
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=

# ---- Cron jobs (Railway Scheduler) ----------------------------------
# Compartilhado por todos os apps; cada app valida o header Authorization.
# Gere com: openssl rand -base64 32
# CRON_SECRET=
