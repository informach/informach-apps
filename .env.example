# =====================================================================
# informach-platform — exemplo de variáveis de ambiente
# Cada app declara em apps/<app>/.env.example o subset que ele consome.
# Apps NUNCA leem variáveis que pertencem a outro app.
# =====================================================================

# ---- Plataforma ------------------------------------------------------
NODE_ENV=development

# Postgres compartilhado por todos os apps. Em prod, referenciado a partir
# do service Postgres do Railway via ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://informach:informach@localhost:5432/informach

# ---- URLs públicas dos apps -----------------------------------------
NEXT_PUBLIC_AGENDA_URL=http://localhost:3001
NEXT_PUBLIC_COZYA_URL=http://localhost:3002

# ---- Observabilidade (placeholder) ----------------------------------
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# ---- Email (placeholder, package @informach/emails) -----------------
# RESEND_API_KEY=

# ---- Billing (placeholder, package @informach/billing) --------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ---- Auth (placeholder, package @informach/auth) --------------------
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=
