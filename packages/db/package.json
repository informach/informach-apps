{
  "name": "@informach/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed:reference": "tsx src/seeds/run-reference.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "papaparse": "^5.5.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/papaparse": "^5.5.2",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
