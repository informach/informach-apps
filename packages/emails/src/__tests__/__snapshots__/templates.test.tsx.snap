exports[`template snapshots > AccountDeletionEmail HTML matches snapshot 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="pt-BR"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/></head><body style="font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, sans-serif;background:#f5f5f5;padding:24px;margin:0"><!--$--><!--html--><!--head--><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0">Confirme a exclusão da sua conta no Test App.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:520px;margin:0 auto;background:#ffffff;border-radius:12px;padding:32px"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin-bottom:24px"><tbody><tr><td><p style="font-size:13px;line-height:24px;font-weight:600;color:#374151;letter-spacing:0.04em;text-transform:uppercase;margin:0;margin-bottom:0;margin-top:0;margin-left:0;margin-right:0">Test App</p></td></tr></tbody></table><h1 style="font-size:20px;margin:0 0 16px">Confirme a exclusão da sua conta</h1><p style="font-size:14px;line-height:22px;color:#111827;margin:0 0 12px;margin-bottom:12px;margin-top:0;margin-left:0;margin-right:0">Recebemos uma solicitação para excluir sua conta no <strong>Test App</strong>.</p><p style="font-size:14px;line-height:22px;color:#111827;margin:0 0 12px;margin-bottom:12px;margin-top:0;margin-left:0;margin-right:0"><strong>Esta ação é irreversível.</strong> Todos os seus dados serão removidos permanentemente.</p><p style="font-size:14px;line-height:22px;color:#111827;margin:0 0 12px;margin-bottom:12px;margin-top:0;margin-left:0;margin-right:0">Se foi você, confirme clicando no botão abaixo. O link expira em breve. Se não foi você, ignore este email — sua conta permanece ativa.</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin:24px 0"><tbody><tr><td><a href="https://app.example.com/action?token=test-token" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background:#111827;color:#ffffff;padding:12px 20px 12px 20px;border-radius:8px" target="_blank"><span><!--[if mso]><i style="mso-font-width:500%;mso-text-raise:18" hidden>&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px">Confirmar exclusão</span><span><!--[if mso]><i style="mso-font-width:500%" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin-top:32px;padding-top:16px;border-top:1px solid #e5e7eb"><tbody><tr><td><p style="font-size:12px;line-height:24px;color:#6b7280;margin:0 0 8px;margin-bottom:8px;margin-top:0;margin-left:0;margin-right:0">Test App</p><p style="font-size:12px;line-height:24px;color:#6b7280;margin:0 0 8px;margin-bottom:8px;margin-top:0;margin-left:0;margin-right:0">Não quer mais receber este tipo de email?<!-- --> <a href="https://app.example.com/api/email/unsubscribe?t=test" style="color:#6b7280;text-decoration-line:none;text-decoration:underline" target="_blank">Cancele a assinatura</a>.</p><p style="font-size:11px;line-height:24px;color:#9ca3af;margin:0;margin-bottom:0;margin-top:0;margin-left:0;margin-right:0">Ou envie um email para<!-- --> <a href="mailto:unsubscribe@app.example.com" style="color:#9ca3af;text-decoration-line:none;text-decoration:underline" target="_blank">unsubscribe@app.example.com</a>.</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"`;

exports[`template snapshots > InvitationEmail HTML matches snapshot 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="pt-BR"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/></head><body style="font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, sans-serif;background:#f5f5f5;padding:24px;margin:0"><!--$--><!--html--><!--head--><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0">Helena convidou você para Escola X no Test App.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:520px;margin:0 auto;background:#ffffff;border-radius:12px;padding:32px"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin-bottom:24px"><tbody><tr><td><p style="font-size:13px;line-height:24px;font-weight:600;color:#374151;letter-spacing:0.04em;text-transform:uppercase;margin:0;margin-bottom:0;margin-top:0;margin-left:0;margin-right:0">Test App</p></td></tr></tbody></table><h1 style="font-size:20px;margin:0 0 16px">Convite para Escola X</h1><p style="font-size:14px;line-height:22px;color:#111827;margin:0 0 12px;margin-bottom:12px;margin-top:0;margin-left:0;margin-right:0"><strong>Helena</strong> convidou você para participar de <strong>Escola X</strong> no Test App.</p><p style="font-size:14px;line-height:22px;color:#111827;margin:0 0 12px;margin-bottom:12px;margin-top:0;margin-left:0;margin-right:0">Aceite o convite clicando no botão abaixo. O link expira em breve.</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin:24px 0"><tbody><tr><td><a href="https://app.example.com/action?token=test-token" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background:#111827;color:#ffffff;padding:12px 20px 12px 20px;border-radius:8px" target="_blank"><span><!--[if mso]><i style="mso-font-width:500%;mso-text-raise:18" hidden>&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px">Aceitar convite</span><span><!--[if mso]><i style="mso-font-width:500%" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin-top:32px;padding-top:16px;border-top:1px solid #e5e7eb"><tbody><tr><td><p style="font-size:12px;line-height:24px;color:#6b7280;margin:0 0 8px;margin-bottom:8px;margin-top:0;margin-left:0;margin-right:0">Test App</p><p style="font-size:12px;line-height:24px;color:#6b7280;margin:0 0 8px;margin-bottom:8px;margin-top:0;margin-left:0;margin-right:0">Não quer mais receber este tipo de email?<!-- --> <a href="https://app.example.com/api/email/unsubscribe?t=test" style="color:#6b7280;text-decoration-line:none;text-decoration:underline" target="_blank">Cancele a assinatura</a>.</p><p style="font-size:11px;line-height:24px;color:#9ca3af;margin:0;margin-bottom:0;margin-top:0;margin-left:0;margin-right:0">Ou envie um email para<!-- --> <a href="mailto:unsubscribe@app.example.com" style="color:#9ca3af;text-decoration-line:none;text-decoration:underline" target="_blank">unsubscribe@app.example.com</a>.</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"`;

