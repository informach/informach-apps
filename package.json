{
  "name": "informach-apps",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "turbo test",
    "dev:admin": "pnpm --filter @informach/admin dev",
    "build:admin": "turbo build --filter=@informach/admin",
    "start:admin": "pnpm --filter @informach/admin start",
    "dev:agenda-da-turma": "pnpm --filter @informach/agenda-da-turma dev",
    "build:agenda-da-turma": "turbo build --filter=@informach/agenda-da-turma",
    "start:agenda-da-turma": "pnpm --filter @informach/agenda-da-turma start",
    "dev:cozya": "pnpm --filter @informach/cozya dev",
    "build:cozya": "turbo build --filter=@informach/cozya",
    "start:cozya": "pnpm --filter @informach/cozya start",
    "dev:missao-saber": "pnpm --filter @informach/missao-saber dev",
    "build:missao-saber": "turbo build --filter=@informach/missao-saber",
    "start:missao-saber": "pnpm --filter @informach/missao-saber start",
    "dev:informach-site": "pnpm --filter @informach/informach-site dev",
    "build:informach-site": "turbo build --filter=@informach/informach-site",
    "start:informach-site": "pnpm --filter @informach/informach-site start",
    "db:generate": "pnpm --filter @informach/db db:generate",
    "db:migrate": "pnpm --filter @informach/db db:migrate && pnpm --filter @informach/ai-core mastra:migrate",
    "db:studio": "pnpm --filter @informach/db db:studio",
    "db:push": "pnpm --filter @informach/db db:push",
    "db:seed": "pnpm --filter @informach/billing seed",
    "db:seed:reference": "pnpm --filter @informach/db db:seed:reference"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "turbo": "^2.9.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.12",
      "fast-uri": "^3.1.2",
      "hono": "^4.12.18",
      "ip-address": "^10.1.1",
      "kysely": "^0.28.17",
      "next": "^16.2.6",
      "postcss": "^8.5.10",
      "vite": "^6.4.2"
    }
  }
}
