{
  "name": "informach-apps",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build --concurrency=2",
    "typecheck": "turbo typecheck --concurrency=2 && pnpm edi:typecheck:tooling",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "turbo test --concurrency=1 && pnpm edi:test:tooling",
    "dev:admin": "pnpm --filter @informach/admin dev",
    "build:admin": "turbo build --filter=@informach/admin",
    "start:admin": "pnpm --filter @informach/admin start",
    "dev:agenda-da-turma": "pnpm --filter @informach/agenda-da-turma dev",
    "build:agenda-da-turma": "turbo build --filter=@informach/agenda-da-turma",
    "start:agenda-da-turma": "pnpm --filter @informach/agenda-da-turma start",
    "dev:cozya": "pnpm --filter @informach/cozya dev",
    "build:cozya": "turbo build --filter=@informach/cozya",
    "start:cozya": "pnpm --filter @informach/cozya start",
    "dev:missao-saber": "pnpm --filter @informach/missao-saber dev",
    "build:missao-saber": "turbo build --filter=@informach/missao-saber",
    "start:missao-saber": "pnpm --filter @informach/missao-saber start",
    "dev:informach-site": "pnpm --filter @informach/informach-site dev",
    "build:informach-site": "turbo build --filter=@informach/informach-site",
    "start:informach-site": "pnpm --filter @informach/informach-site start",
    "dev:edi": "pnpm --filter @informach/edi dev",
    "build:edi": "turbo build --filter=@informach/edi",
    "start:edi": "pnpm --filter @informach/edi start",
    "db:generate": "pnpm --filter @informach/db db:generate",
    "db:migrate": "pnpm --filter @informach/db db:migrate && pnpm --filter @informach/db db:backfill-tasks && pnpm --filter @informach/ai-core mastra:migrate",
    "db:studio": "pnpm --filter @informach/db db:studio",
    "db:push": "pnpm --filter @informach/db db:push",
    "db:seed": "pnpm --filter @informach/billing seed",
    "db:seed:reference": "pnpm --filter @informach/db db:seed:reference",
    "edi:test:integration": "node scripts/edi/integration.mjs",
    "edi:compare-sources": "node scripts/edi/compare-sources.mjs",
    "edi:installer": "tsx scripts/edi/release.mts build",
    "edi:publish": "tsx scripts/edi/release.mts publish",
    "edi:setup:github": "node scripts/edi/setup-github.mjs",
    "edi:test:package": "node scripts/edi/test-package.mjs",
    "edi:test:upgrade": "tsx scripts/edi/test-upgrade.mts",
    "edi:media:build": "tsx scripts/edi/build-media.mts",
    "edi:media:test": "tsx scripts/edi/test-media.mts",
    "edi:typecheck:tooling": "tsc --project scripts/edi/tsconfig.json",
    "edi:test:tooling": "vitest run --config scripts/edi/vitest.config.mts",
    "edi:open": "node scripts/edi/open-licensed.mts",
    "edi:test:native": "node scripts/edi/test-native.mts",
    "edi:test:pdf-view": "node apps/edipdf/scripts/probe-view-restart.mts",
    "edi:test:visual": "node scripts/edi/visual-ediaula.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@electron/fuses": "2.1.3",
    "@types/node": "^24.19.2",
    "@types/proper-lockfile": "^4.1.4",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "playwright": "1.59.1",
    "proper-lockfile": "4.1.2",
    "railway": "3.16.0",
    "tsx": "4.21.0",
    "turbo": "^2.11.9",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "^5.0.5",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "18.4.0-beta.17"
  },
  "pnpm": {
    "overrides": {
      "@electron/get>global-agent": "4.1.3",
      "@mastra/core>gray-matter": "npm:@11ty/gray-matter@3.0.0",
      "esbuild@<0.28.2": "^0.28.2",
      "fast-uri": "^3.1.9",
      "hono": "^4.13.13",
      "ip-address": "^10.7.4",
      "kysely": "^0.28.17",
      "next": "^16.4.2",
      "postcss": "^8.5.23",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "pptxgenjs@4.0.1>image-size": "2.0.3",
      "pptxgenjs@4.0.1>https": "-",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0"
    }
  }
}
