{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "SENDGRID_API_KEY",
        "SENDGRID_FROM",
        "SENDGRID_WEBHOOK_PUBLIC_KEY",
        "EMAIL_SANDBOX_MODE",
        "EMAIL_SANDBOX_DIR",
        "CRON_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "REDIS_URL",
        "SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_DSN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_AUTH_TOKEN",
        "NEXT_PUBLIC_APP_URL",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "STRIPE_PUBLISHABLE_KEY",
        "STRIPE_MODE",
        "STRIPE_PORTAL_CONFIGURATION_ID",
        "RAILWAY_ENVIRONMENT_ID",
        "OPENROUTER_API_KEY",
        "OPENROUTER_HTTP_REFERER",
        "OPENROUTER_X_TITLE",
        "AGENDA_TRIAL_DAILY_BUDGET",
        "VAPID_PUBLIC_KEY",
        "VAPID_PRIVATE_KEY",
        "CSP_ENFORCE",
        "LOG_LEVEL",
        "MASTRA_LOG_LEVEL",
        "MISSAO_CONTENT_MANAGER_IDS",
        "MISSAO_CONTENT_MANAGER_EMAILS",
        "MISSAO_METRICS_EXCLUDED_EMAILS",
        "MISSAO_INDIVIDUAL_MONTHLY_PRICE",
        "MISSAO_INDIVIDUAL_ANNUAL_PRICE",
        "MISSAO_FAMILY_MONTHLY_PRICE",
        "MISSAO_FAMILY_ANNUAL_PRICE"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": [],
      "outputs": []
    }
  }
}
