{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": [
    "npm_execpath",
    "JOBS",
    "COMPASSO_TEST_APP",
    "COMPASSO_ISOLATED_DATABASE",
    "COMPASSO_CLOSURE_STAGE",
    "COMPASSO_CLOSURE_FIXTURE"
  ],
  "cacheMaxAge": "7d",
  "cacheMaxSize": "10GB",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**", "out/**"],
      "env": [
        "NODE_ENV",
        "EDI_COMMERCIAL_BUILD",
        "EDI_PORTAL_URL",
        "EDI_DESKTOP_CLIENT_ID",
        "EDI_LICENSE_PUBLIC_KEYS",
        "EDI_MINIMUM_CLIENT_VERSION",
        "EDI_DISTRIBUTION_REPOSITORY",
        "EDI_UPDATE_PUBLIC_KEYS",
        "EDI_RELEASE_TAG",
        "EDI_BILLING_ENABLED",
        "COMPASSO_BILLING_ENABLED",
        "COMPASSO_TRIAL_HASH_SECRET",
        "COMPASSO_MONTHLY_PRICE",
        "COMPASSO_ANNUAL_PRICE",
        "COMPASSO_CREDITS_100_PRICE",
        "COMPASSO_CREDITS_300_PRICE",
        "COMPASSO_CREDITS_1000_PRICE",
        "EDI_MONTHLY_PRICE_DEV",
        "EDI_MONTHLY_PRICE_PROD",
        "EDI_ANNUAL_PRICE_DEV",
        "EDI_ANNUAL_PRICE_PROD",
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "SENDGRID_API_KEY",
        "SENDGRID_FROM",
        "SENDGRID_WEBHOOK_PUBLIC_KEY",
        "EMAIL_SANDBOX_MODE",
        "EMAIL_SANDBOX_DIR",
        "CRON_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "REDIS_URL",
        "SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_DSN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_AUTH_TOKEN",
        "NEXT_PUBLIC_APP_URL",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "STRIPE_PUBLISHABLE_KEY",
        "STRIPE_MODE",
        "STRIPE_PORTAL_CONFIGURATION_ID",
        "RAILWAY_ENVIRONMENT_ID",
        "RAILWAY_ENVIRONMENT_NAME",
        "RAILWAY_GIT_COMMIT_SHA",
        "NEXT_PUBLIC_RAILWAY_ENVIRONMENT_NAME",
        "NEXT_PUBLIC_RAILWAY_GIT_COMMIT_SHA",
        "OPENROUTER_API_KEY",
        "OPENROUTER_HTTP_REFERER",
        "OPENROUTER_X_TITLE",
        "AGENDA_TRIAL_DAILY_BUDGET",
        "VAPID_PUBLIC_KEY",
        "VAPID_PRIVATE_KEY",
        "CSP_ENFORCE",
        "LOG_LEVEL",
        "MASTRA_LOG_LEVEL",
        "MISSAO_CONTENT_MANAGER_IDS",
        "MISSAO_CONTENT_MANAGER_EMAILS",
        "MISSAO_METRICS_EXCLUDED_EMAILS",
        "MISSAO_INDIVIDUAL_MONTHLY_PRICE",
        "MISSAO_INDIVIDUAL_ANNUAL_PRICE",
        "MISSAO_FAMILY_MONTHLY_PRICE",
        "MISSAO_FAMILY_ANNUAL_PRICE",
        "BORA_INDIVIDUAL_MONTHLY_PRICE",
        "BORA_INDIVIDUAL_ANNUAL_PRICE",
        "BORA_FAMILY_MONTHLY_PRICE",
        "BORA_FAMILY_ANNUAL_PRICE",
        "ADMIN_RECREIO_ENABLED",
        "ADMIN_COMPASSO_ENABLED",
        "RECREIO_ACCESS_MODE",
        "RECREIO_TOKEN_PRIVATE_KEY",
        "RECREIO_TOKEN_KEY_ID",
        "RECREIO_TOKEN_PREVIOUS_PUBLIC_KEYS",
        "RECREIO_HOST_SECRETS",
        "RECREIO_GAME_ORIGINS",
        "RECREIO_JOGO_DE_TESTE"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": [],
      "outputs": []
    }
  }
}
