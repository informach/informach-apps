import { execFile } from "node:child_process";
import { generateKeyPairSync } from "node:crypto";
import { mkdir, writeFile } from "node:fs/promises";
import { join } from "node:path";
import { fileURLToPath } from "node:url";
import { promisify } from "node:util";
import { tsImport } from "tsx/esm/api";
import { build } from "vite";

/** Runs the production inventory reader inside Electron, without installing an application. */
export async function verifyNativeInstallationIntegrity(root: string, electronPath: string) {
  // Scope TS module resolution to the Node packaging helpers. Transpiling the
  // Playwright harness itself would alter functions serialized into its pages.
  const {
    fileDigest,
    writeInstallationReceipt,
  }: typeof import("../../packages/edi-desktop/src/installation-integrity.ts") = await tsImport(
    "../../packages/edi-desktop/src/installation-integrity.ts",
    import.meta.url,
  );
  const directory = join(root, "installation");
  const profile = join(root, "integrity-profile");
  await mkdir(join(directory, "resources"), { recursive: true });
  await mkdir(profile, { recursive: true });
  // Real ASAR generated by @electron/asar 3.4.1: app.txt contains "fixture".
  // A fixed archive avoids a second packaging dependency in the test harness.
  const archive = Buffer.from(
    "",
    "base64",
  );
  const archivePath = join(directory, "resources/app.asar");
  await writeFile(archivePath, archive);
  await writeFile(join(directory, "EdiFoto.exe"), "inventory-only fixture, never executed");
  const pair = generateKeyPairSync("ed25519");
  const trustedKeys = { native: pair.publicKey.export({ type: "spki", format: "pem" }).toString() };
  await writeInstallationReceipt({
    directory,
    appId: "edifoto",
    version: "1.0.0",
    sourceCommit: "a".repeat(40),
    keyId: "native",
    privateKey: pair.privateKey.export({ type: "pkcs8", format: "pem" }).toString(),
  });
  const configuration = join(root, "integrity-configuration.json");
  await writeFile(
    configuration,
    JSON.stringify({ directory, profile, trustedKeys, digest: await fileDigest(archivePath) }),
  );
  const output = join(root, "integrity-runner");
  await build({
    configFile: false,
    logLevel: "error",
    ssr: { noExternal: true, external: ["electron", "original-fs"] },
    build: {
      ssr: fileURLToPath(new URL("./native-installation.fixture.mts", import.meta.url)),
      outDir: output,
      emptyOutDir: false,
      rollupOptions: {
        external: ["electron", "original-fs"],
        output: { format: "cjs", entryFileNames: "verify.cjs" },
      },
    },
  });
  const environment = { ...process.env };
  delete environment.ELECTRON_RUN_AS_NODE;
  delete environment.NODE_OPTIONS;
  const result = await promisify(execFile)(
    electronPath,
    [join(output, "verify.cjs"), configuration],
    {
      env: environment,
      windowsHide: true,
      timeout: 30000,
      maxBuffer: 1024 * 1024,
    },
  );
  console.log(result.stdout.trim());
}
